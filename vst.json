{
  "name": "JV-880",
  "vendor": "sd88me",
  "uid": "JV88",
  "version": 1000,
  "so": "jv880.so",
  "module": "module.json",
  "layout": "layout.conf",
  "title_font": "Audiowide-Regular.ttf",
  "defines": {"MODULE_DIR": "\"/sdcard/vst/jv880-roms\""},
